{
  "$defs": {
    "AddMarker": {
      "additionalProperties": false,
      "description": "Add a marker. ``frame`` is an offset within the clip (0 = clip start).",
      "properties": {
        "op": {
          "const": "add_marker",
          "default": "add_marker",
          "title": "Op",
          "type": "string"
        },
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "frame": {
          "default": 0,
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "color": {
          "default": "Blue",
          "title": "Color",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "duration": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Duration",
          "type": "integer"
        }
      },
      "required": [
        "clip_id"
      ],
      "title": "AddMarker",
      "type": "object"
    },
    "AddTrack": {
      "additionalProperties": false,
      "description": "Add a new track to the timeline (organizing primitive).",
      "properties": {
        "op": {
          "const": "add_track",
          "default": "add_track",
          "title": "Op",
          "type": "string"
        },
        "kind": {
          "default": "video",
          "enum": [
            "video",
            "audio",
            "subtitle"
          ],
          "title": "Kind",
          "type": "string"
        },
        "audio_type": {
          "default": "stereo",
          "description": "for audio tracks: mono/stereo/5.1/7.1 etc (Resolve subTrackType)",
          "title": "Audio Type",
          "type": "string"
        }
      },
      "title": "AddTrack",
      "type": "object"
    },
    "AddTransition": {
      "additionalProperties": false,
      "description": "Add a transition on a clip edge (e.g. a cross dissolve at the 'in' edge).",
      "properties": {
        "op": {
          "const": "add_transition",
          "default": "add_transition",
          "title": "Op",
          "type": "string"
        },
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "edge": {
          "default": "out",
          "enum": [
            "in",
            "out"
          ],
          "title": "Edge",
          "type": "string"
        },
        "type": {
          "default": "cross_dissolve",
          "title": "Type",
          "type": "string"
        },
        "duration": {
          "default": 12,
          "exclusiveMinimum": 0,
          "title": "Duration",
          "type": "integer"
        }
      },
      "required": [
        "clip_id"
      ],
      "title": "AddTransition",
      "type": "object"
    },
    "CreateBin": {
      "additionalProperties": false,
      "description": "Create a media-pool bin/folder (organizing primitive).",
      "properties": {
        "op": {
          "const": "create_bin",
          "default": "create_bin",
          "title": "Op",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent": {
          "default": "",
          "description": "parent bin name; empty = the media-pool root",
          "title": "Parent",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "CreateBin",
      "type": "object"
    },
    "Delete": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "delete",
          "default": "delete",
          "title": "Op",
          "type": "string"
        },
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "ripple": {
          "default": false,
          "description": "close the gap left behind",
          "title": "Ripple",
          "type": "boolean"
        }
      },
      "required": [
        "clip_id"
      ],
      "title": "Delete",
      "type": "object"
    },
    "ImportAudio": {
      "additionalProperties": false,
      "description": "Import a sound effect / audio file and place it on an audio track.\n\nReference the effect by ``sfx`` (a name in the user's SFX library) OR ``src_ref`` (an explicit\naudio file path). The host resolves ``sfx`` \u2192 a real path via the SFX library, imports it into the\nproject's media pool, and lands it on ``track`` at ``at_start``.\n\nHonest limitation: per-clip volume/gain/fades are NOT settable via Resolve scripting (Fairlight\nonly). This op *places* audio; level/fade tweaks stay a manual step \u2014 see ``AUDIO_PROPS_UNSUPPORTED``.",
      "properties": {
        "op": {
          "const": "import_audio",
          "default": "import_audio",
          "title": "Op",
          "type": "string"
        },
        "track": {
          "description": "target AUDIO track code, e.g. 'a1'",
          "title": "Track",
          "type": "string"
        },
        "at_start": {
          "default": 0,
          "description": "timeline frame to place the audio",
          "minimum": 0,
          "title": "At Start",
          "type": "integer"
        },
        "sfx": {
          "default": "",
          "description": "name of an effect in the user's SFX library",
          "title": "Sfx",
          "type": "string"
        },
        "src_ref": {
          "default": "",
          "description": "explicit audio file path (alternative to 'sfx')",
          "title": "Src Ref",
          "type": "string"
        },
        "source_in": {
          "default": 0,
          "description": "frame offset into the audio source",
          "minimum": 0,
          "title": "Source In",
          "type": "integer"
        },
        "duration": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "frames to place; None = the file's full length",
          "title": "Duration"
        }
      },
      "required": [
        "track"
      ],
      "title": "ImportAudio",
      "type": "object"
    },
    "Insert": {
      "additionalProperties": false,
      "description": "Insert a media reference as a new clip on a track at a timeline frame.",
      "properties": {
        "op": {
          "const": "insert",
          "default": "insert",
          "title": "Op",
          "type": "string"
        },
        "src_ref": {
          "description": "media basename or media-pool id to place",
          "title": "Src Ref",
          "type": "string"
        },
        "track": {
          "description": "target track code, e.g. 'v1' or 'a1'",
          "title": "Track",
          "type": "string"
        },
        "at_start": {
          "minimum": 0,
          "title": "At Start",
          "type": "integer"
        },
        "source_in": {
          "default": 0,
          "minimum": 0,
          "title": "Source In",
          "type": "integer"
        },
        "duration": {
          "exclusiveMinimum": 0,
          "title": "Duration",
          "type": "integer"
        },
        "media_type": {
          "default": "auto",
          "description": "'auto' infers from the track code (a* = audio); set explicitly to force",
          "enum": [
            "auto",
            "video",
            "audio"
          ],
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "src_ref",
        "track",
        "at_start",
        "duration"
      ],
      "title": "Insert",
      "type": "object"
    },
    "Move": {
      "additionalProperties": false,
      "description": "Move a clip to a new timeline start frame, optionally to another track.",
      "properties": {
        "op": {
          "const": "move",
          "default": "move",
          "title": "Op",
          "type": "string"
        },
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "to_start": {
          "description": "new timeline start frame",
          "minimum": 0,
          "title": "To Start",
          "type": "integer"
        },
        "to_track": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'v2'; None keeps current track",
          "title": "To Track"
        }
      },
      "required": [
        "clip_id",
        "to_start"
      ],
      "title": "Move",
      "type": "object"
    },
    "MoveToBin": {
      "additionalProperties": false,
      "description": "Move a clip's source media into a media-pool bin (organizing primitive).",
      "properties": {
        "op": {
          "const": "move_to_bin",
          "default": "move_to_bin",
          "title": "Op",
          "type": "string"
        },
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "bin": {
          "description": "destination bin name",
          "maxLength": 120,
          "minLength": 1,
          "title": "Bin",
          "type": "string"
        }
      },
      "required": [
        "clip_id",
        "bin"
      ],
      "title": "MoveToBin",
      "type": "object"
    },
    "RenameTrack": {
      "additionalProperties": false,
      "description": "Rename an existing track (organizing primitive).",
      "properties": {
        "op": {
          "const": "rename_track",
          "default": "rename_track",
          "title": "Op",
          "type": "string"
        },
        "track": {
          "description": "track code to rename, e.g. 'v2' or 'a1'",
          "title": "Track",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "track",
        "name"
      ],
      "title": "RenameTrack",
      "type": "object"
    },
    "Retime": {
      "additionalProperties": false,
      "description": "Change a clip's playback speed \u2014 the real retime primitive, via an OTIO time-warp effect.\n\n``speed_percent`` is a percentage of normal speed: 100 = normal, 200 = 2\u00d7 faster, 50 = half\nspeed, a negative value plays in reverse (e.g. -100 = reverse at normal speed), and 0 = a\nfreeze-frame. It maps to an ``otio.schema.LinearTimeWarp`` (``FreezeFrame`` at 0) on the clip,\nwhich the OTIO-rebuild path carries \u2014 so it lands on every rebuild/interchange editor and in\nResolve via the rebuild. The warp changes how the source plays *within* the clip's existing\ntimeline span; it does not move neighbours (re-ripple separately if you want the gap closed).",
      "properties": {
        "op": {
          "const": "retime",
          "default": "retime",
          "title": "Op",
          "type": "string"
        },
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "speed_percent": {
          "default": 100.0,
          "description": "100=normal, 200=2x faster, 50=half speed, negative=reverse, 0=freeze-frame",
          "maximum": 10000.0,
          "minimum": -10000.0,
          "title": "Speed Percent",
          "type": "number"
        }
      },
      "required": [
        "clip_id"
      ],
      "title": "Retime",
      "type": "object"
    },
    "Ripple": {
      "additionalProperties": false,
      "description": "Shift every clip at/after ``from_frame`` on a track by ``delta`` frames.",
      "properties": {
        "op": {
          "const": "ripple",
          "default": "ripple",
          "title": "Op",
          "type": "string"
        },
        "from_frame": {
          "minimum": 0,
          "title": "From Frame",
          "type": "integer"
        },
        "delta": {
          "title": "Delta",
          "type": "integer"
        },
        "track": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "restrict to one track code, else all",
          "title": "Track"
        }
      },
      "required": [
        "from_frame",
        "delta"
      ],
      "title": "Ripple",
      "type": "object"
    },
    "SetEnabled": {
      "additionalProperties": false,
      "description": "Enable or disable a clip without removing it (a disabled clip stays on the timeline but is\nskipped on playback/render). Lands live in Resolve (``SetClipEnabled``) and via the OTIO\nrebuild (the clip's ``enabled`` flag).",
      "properties": {
        "op": {
          "const": "set_enabled",
          "default": "set_enabled",
          "title": "Op",
          "type": "string"
        },
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "enabled": {
          "description": "True = enable the clip, False = disable (mute) it",
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "clip_id",
        "enabled"
      ],
      "title": "SetEnabled",
      "type": "object"
    },
    "SetProperty": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "set_property",
          "default": "set_property",
          "title": "Op",
          "type": "string"
        },
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "clip_id",
        "key",
        "value"
      ],
      "title": "SetProperty",
      "type": "object"
    },
    "Split": {
      "additionalProperties": false,
      "description": "Split a clip into two at a timeline frame inside it.",
      "properties": {
        "op": {
          "const": "split",
          "default": "split",
          "title": "Op",
          "type": "string"
        },
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "at_frame": {
          "description": "absolute timeline frame, must fall inside the clip",
          "minimum": 0,
          "title": "At Frame",
          "type": "integer"
        }
      },
      "required": [
        "clip_id",
        "at_frame"
      ],
      "title": "Split",
      "type": "object"
    },
    "Trim": {
      "additionalProperties": false,
      "description": "Adjust a clip's in- or out-point by ``delta`` frames (negative = shorten/move earlier).",
      "properties": {
        "op": {
          "const": "trim",
          "default": "trim",
          "title": "Op",
          "type": "string"
        },
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "edge": {
          "enum": [
            "in",
            "out"
          ],
          "title": "Edge",
          "type": "string"
        },
        "delta": {
          "description": "frames to move the edge; +out lengthens, +in shortens head",
          "title": "Delta",
          "type": "integer"
        }
      },
      "required": [
        "clip_id",
        "edge",
        "delta"
      ],
      "title": "Trim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An ordered list of typed ops plus an optional one-line rationale.",
  "properties": {
    "version": {
      "default": 2,
      "title": "Version",
      "type": "integer"
    },
    "notes": {
      "default": "",
      "description": "one-line rationale (optional)",
      "maxLength": 400,
      "title": "Notes",
      "type": "string"
    },
    "ops": {
      "items": {
        "discriminator": {
          "mapping": {
            "add_marker": "#/$defs/AddMarker",
            "add_track": "#/$defs/AddTrack",
            "add_transition": "#/$defs/AddTransition",
            "create_bin": "#/$defs/CreateBin",
            "delete": "#/$defs/Delete",
            "import_audio": "#/$defs/ImportAudio",
            "insert": "#/$defs/Insert",
            "move": "#/$defs/Move",
            "move_to_bin": "#/$defs/MoveToBin",
            "rename_track": "#/$defs/RenameTrack",
            "retime": "#/$defs/Retime",
            "ripple": "#/$defs/Ripple",
            "set_enabled": "#/$defs/SetEnabled",
            "set_property": "#/$defs/SetProperty",
            "split": "#/$defs/Split",
            "trim": "#/$defs/Trim"
          },
          "propertyName": "op"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/Trim"
          },
          {
            "$ref": "#/$defs/Move"
          },
          {
            "$ref": "#/$defs/Insert"
          },
          {
            "$ref": "#/$defs/Delete"
          },
          {
            "$ref": "#/$defs/SetProperty"
          },
          {
            "$ref": "#/$defs/AddMarker"
          },
          {
            "$ref": "#/$defs/AddTransition"
          },
          {
            "$ref": "#/$defs/Split"
          },
          {
            "$ref": "#/$defs/Ripple"
          },
          {
            "$ref": "#/$defs/ImportAudio"
          },
          {
            "$ref": "#/$defs/AddTrack"
          },
          {
            "$ref": "#/$defs/RenameTrack"
          },
          {
            "$ref": "#/$defs/CreateBin"
          },
          {
            "$ref": "#/$defs/MoveToBin"
          },
          {
            "$ref": "#/$defs/Retime"
          },
          {
            "$ref": "#/$defs/SetEnabled"
          }
        ]
      },
      "title": "Ops",
      "type": "array"
    }
  },
  "title": "EditPlan",
  "type": "object"
}